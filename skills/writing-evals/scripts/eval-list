#!/usr/bin/env bash
# List eval cases without running them
# Usage: eval-list [target]
# npm helper: requires an eval script in the target package ("eval": "axiom eval").
# For other package managers or script names, run the project command directly.
#
# Arguments:
#   target    File, directory, glob, or eval name (default: current directory)
#
# Examples:
#   eval-list                            # List all cases
#   eval-list src/my-feature.eval.ts     # List cases in file

set -euo pipefail

exec npm run eval -- "${1:-.}" --list
