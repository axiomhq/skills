#!/usr/bin/env bash
# Setup writing-evals skill
# Usage: scripts/setup
#
# This script:
#   1. Checks for required tools (node)
#   2. Checks the Node.js version
#   3. Makes scripts executable

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

echo "=== writing-evals Setup ==="
echo ""

# --- Check required tools ---
echo "[1/3] Checking required tools..."

MISSING=()
for cmd in node; do
    if command -v "$cmd" &> /dev/null; then
        echo "✓ $cmd found ($(command -v "$cmd"))"
    else
        echo "✗ $cmd not found"
        MISSING+=("$cmd")
    fi
done

if [[ ${#MISSING[@]} -gt 0 ]]; then
    echo ""
    echo "Install missing tools:"
    echo "  https://nodejs.org/"
    exit 1
fi

# --- Check Node version ---
echo ""
echo "[2/3] Checking Node.js version..."
NODE_VERSION=$(node -v | sed 's/v//')
NODE_MAJOR=$(echo "$NODE_VERSION" | cut -d. -f1)
if [[ "$NODE_MAJOR" -ge 18 ]]; then
    echo "✓ Node.js v$NODE_VERSION (>= 18 required)"
else
    echo "✗ Node.js v$NODE_VERSION is too old (>= 18 required)"
    exit 1
fi

# --- Make scripts executable ---
echo ""
echo "[3/3] Making scripts executable..."
chmod +x "$SCRIPT_DIR"/*
echo "✓ Scripts ready"

echo ""
echo "=== Setup Complete ==="
echo ""
echo "Quick start:"
echo "  1. Install axiom with your project’s package manager"
echo "  2. Set env vars:   export AXIOM_TOKEN=xaat-... AXIOM_DATASET=my-dataset"
echo "  3. Create eval:    scripts/eval-scaffold classification my-capability my-step"
echo "  4. Reuse your eval script, or add scripts.eval = axiom eval to package.json"
echo "  5. Run it with your package manager (npm: npm run eval -- --debug)"
echo ""
