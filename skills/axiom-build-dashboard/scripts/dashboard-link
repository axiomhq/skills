#!/usr/bin/env bash
# Generate a Console link to a dashboard or notifier.
#
# Usage: dashboard-link <deployment> <dashboard-id>
#        dashboard-link [prod|staging|dev] --notifier <id|new> (default: prod)
#
# Examples:
#   dashboard-link prod EHYTHcQmO0ZZCK0zdw
#   dashboard-link staging abc123

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [[ "${1:-}" == --notifier ]]; then
    set -- prod "$@"
fi
DEPLOYMENT="${1:-}"
DASHBOARD_ID="${2:-}"

if [[ -z "$DEPLOYMENT" || -z "$DASHBOARD_ID" ]]; then
    echo "Usage: dashboard-link <deployment> <dashboard-id>" >&2
    exit 1
fi

CONFIG_FILE="$HOME/.axiom.toml"
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: $CONFIG_FILE not found" >&2
    exit 1
fi

# Parse TOML for deployment config
extract_value() {
    local key="$1"
    awk -v deployment="$DEPLOYMENT" -v key="$key" '
        /^[[:space:]]*\[/ {
            sub(/^[[:space:]]*/, "")
            in_deployment = (index($0, "[deployments." deployment "]") == 1)
        }
        in_deployment {
            gsub(/^[[:space:]]+/, "")
            if ($1 == key) {
                sub(/^[^=]*=[[:space:]]*/, "")
                if (match($0, /^"[^"]*"/)) {
                    $0 = substr($0, RSTART+1, RLENGTH-2)
                } else {
                    sub(/[[:space:]]*#.*$/, "")
                }
                print
                exit
            }
        }
    ' "$CONFIG_FILE"
}

ORG_ID=$(extract_value "org_id")
if [[ -z "$ORG_ID" ]]; then
    echo "Error: Could not find deployment '$DEPLOYMENT' in $CONFIG_FILE" >&2
    exit 1
fi

if [[ "$DASHBOARD_ID" == --notifier ]]; then
    id="${3:?Usage: dashboard-link [prod|staging|dev] --notifier <id|new>}"
    case "$DEPLOYMENT" in
        prod)    base=https://app.axiom.co ;;
        staging) base=https://app.staging.axiomtestlabs.co ;;
        dev)     base=https://app.dev.axiomtestlabs.co ;;
        *) echo "Open Notifiers in the Console for '$DEPLOYMENT'." >&2; exit 1 ;;
    esac
    exec jq -nr --arg base "$base" --arg org "$ORG_ID" --arg id "$id" \
        '"\($base)/\($org | @uri)/notifiers?notifierId=\($id | @uri)"'
fi

URL=$(extract_value "url")
if [[ -z "$URL" ]]; then
    echo "Error: Could not find deployment '$DEPLOYMENT' in $CONFIG_FILE" >&2
    exit 1
fi

# Resolve short ID for the UI URL
LINK_ID=$("$SCRIPT_DIR/axiom-api" "$DEPLOYMENT" GET "/dashboards/uid/$DASHBOARD_ID" | jq -r '.id // empty')
if [[ -z "$LINK_ID" ]]; then
    echo "Error: Could not resolve dashboard ID '$DASHBOARD_ID'" >&2
    exit 1
fi

APP_URL="${URL/api./app.}"
echo "${APP_URL}/${ORG_ID}/dashboards/${LINK_ID}"
