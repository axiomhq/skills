#!/usr/bin/env bash
# Generate a Console link for a dashboard, a saved notifier, or a new notifier.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DEPLOYMENT="${1:-}"
RESOURCE="${2:-}"
ID="${3:-}"

if [[ -z "$DEPLOYMENT" || -z "$ID" || ( "$RESOURCE" != dashboard && "$RESOURCE" != notifier ) ]]; then
    echo "Usage: console-link <deployment> dashboard <id> | console-link <deployment> notifier <id|new>" >&2
    exit 1
fi

CONFIG_FILE="$HOME/.axiom.toml"
if [[ ! -f "$CONFIG_FILE" ]]; then
    echo "Error: $CONFIG_FILE not found" >&2
    exit 1
fi

# Parse TOML for deployment config
extract_value() {
    local key="$1"
    awk -v deployment="$DEPLOYMENT" -v key="$key" '
        /^[[:space:]]*\[/ {
            sub(/^[[:space:]]+/, "")
            in_deployment = (index($0, "[deployments." deployment "]") == 1)
        }
        in_deployment {
            gsub(/^[[:space:]]+/, "")
            if ($1 == key) {
                sub(/^[^=]*=[[:space:]]*/, "")
                if (match($0, /^"[^"]*"/)) {
                    $0 = substr($0, RSTART+1, RLENGTH-2)
                } else {
                    sub(/[[:space:]]*#.*$/, "")
                }
                print
                exit
            }
        }
    ' "$CONFIG_FILE"
}

URL=$(extract_value "url")
ORG_ID=$(extract_value "org_id")

if [[ -z "$URL" || -z "$ORG_ID" ]]; then
    echo "Error: Could not find deployment '$DEPLOYMENT' in $CONFIG_FILE" >&2
    exit 1
fi

# Convert the deployment's API URL to its Console URL.
APP_URL="${URL%/}"
if [[ "$APP_URL" == "https://cloud.axiom.co" ]]; then
    APP_URL="https://app.axiom.co"
elif [[ "$APP_URL" == *://api.* ]]; then
    APP_URL="${APP_URL/api./app.}"
fi

if [[ "$RESOURCE" == notifier ]]; then
    # With an unfamiliar host, let the user open their own Console to enter credentials.
    if [[ ! "$APP_URL" =~ ^https://app\.([a-zA-Z0-9-]+\.)*(axiom\.co|axiomtestlabs\.co)$ ]]; then
        echo "Open Notifiers in the Console for this deployment." >&2
        exit 1
    fi
    jq -nr --arg base "$APP_URL" --arg org "$ORG_ID" --arg id "$ID" \
        '"\($base)/\($org | @uri)/notifiers?notifierId=\($id | @uri)"'
    exit
fi

# Resolve the dashboard's short ID for the UI URL.
LINK_ID=$("$SCRIPT_DIR/axiom-api" "$DEPLOYMENT" GET "/dashboards/uid/$ID" | jq -r '.id // empty')
if [[ -z "$LINK_ID" ]]; then
    echo "Error: Could not resolve dashboard ID '$ID'" >&2
    exit 1
fi

echo "${APP_URL}/${ORG_ID}/dashboards/${LINK_ID}"
