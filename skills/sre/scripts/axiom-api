#!/usr/bin/env bash
# Axiom API helper - uses unified config
# Usage: axiom-api <deployment> <method> <endpoint> [body]
# Examples:
#   axiom-api dev POST "/v1/query/_apl?format=tabular" '{"apl": "..."}'
#   axiom-api dev GET "/v1/datasets"

set -euo pipefail

DEPLOYMENT="${1:-}"
METHOD="${2:-GET}"
ENDPOINT="${3:-}"
BODY="${4:-}"

if [[ -z "$DEPLOYMENT" || -z "$ENDPOINT" ]]; then
  echo "Usage: axiom-api <deployment> <method> <endpoint> [body]" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
eval "$("$SCRIPT_DIR/config" axiom "$DEPLOYMENT")"

resolve_edge_base_url() {
  local base_url="${AXIOM_URL%/}"
  local edge_url="${AXIOM_EDGE_URL:-}"
  local override_url="${AXIOM_URL_OVERRIDE:-}"

  if [[ -n "$override_url" ]]; then
    if [[ "$override_url" != *://* ]]; then
      override_url="https://$override_url"
    fi
    printf '%s\n' "${override_url%/}"
    return
  fi

  if [[ "$base_url" =~ ^https://([a-z0-9-]+\.)+edge\.axiom\.co$ ]]; then
    printf '%s\n' "$base_url"
    return
  fi

  if [[ "$base_url" =~ ^https://(api|app)\.axiom\.co$ ]]; then
    local cache_dir="${SRE_CONFIG_DIR:-$HOME/.config/axiom-sre}/cache/axiom/$DEPLOYMENT"
    local cache_file="$cache_dir/datasets.json"
    local catalog=""

    if [[ "${SRE_NO_CACHE:-}" != "1" && -f "$cache_file" ]]; then
      local now mtime age
      now=$(date +%s)
      mtime=$(stat -c %Y "$cache_file" 2>/dev/null || stat -f %m "$cache_file" 2>/dev/null || echo 0)
      age=$(( now - mtime ))
      if [[ "$age" -lt 600 ]]; then
        catalog=$(cat "$cache_file" 2>/dev/null || true)
      fi
    fi

    if [[ -z "$catalog" ]]; then
      catalog=$("$SCRIPT_DIR/curl-auth" axiom "$DEPLOYMENT" -X GET "$base_url/v1/datasets" 2>/dev/null || true)
      if [[ -n "$catalog" ]] && printf '%s' "$catalog" | jq -e 'type == "array"' >/dev/null 2>&1; then
        mkdir -p "$cache_dir" 2>/dev/null || true
        local tmp_file="$cache_file.tmp.$$"
        if printf '%s' "$catalog" > "$tmp_file" 2>/dev/null; then
          chmod 600 "$tmp_file" 2>/dev/null || true
          mv "$tmp_file" "$cache_file" 2>/dev/null || true
        fi
      else
        catalog=""
      fi
    fi

    if [[ -n "$catalog" ]]; then
      local discovered_edge=""
      discovered_edge=$(printf '%s' "$catalog" | jq -r '
        first(.[] | .edgeDeploymentUrl // (if .edgeDeployment then "https://" + (.edgeDeployment | sub("^cloud\\."; "")) + ".edge.axiom.co" else empty end) | select(length > 0)) // empty
      ' 2>/dev/null)
      if [[ -n "$discovered_edge" && "$discovered_edge" != "null" ]]; then
        printf '%s\n' "${discovered_edge%/}"
        return
      fi
    fi
  fi

  if [[ -n "$edge_url" ]]; then
    if [[ "$edge_url" != *://* ]]; then
      edge_url="https://$edge_url"
    fi
    printf '%s\n' "${edge_url%/}"
    return
  fi
}

TARGET_BASE_URL="${AXIOM_URL%/}"
TARGET_ENDPOINT="$ENDPOINT"

if [[ "$ENDPOINT" == /v1/query/* || "$ENDPOINT" == /v1/datasets/_apl* ]]; then
  EDGE_BASE_URL=$(resolve_edge_base_url)
  if [[ -n "$EDGE_BASE_URL" ]]; then
    TARGET_BASE_URL="$EDGE_BASE_URL"
    if [[ "$TARGET_ENDPOINT" == /v1/datasets/_apl* ]]; then
      TARGET_ENDPOINT="/v1/query/_apl${TARGET_ENDPOINT#/v1/datasets/_apl}"
    fi
  elif [[ "$TARGET_ENDPOINT" == /v1/query/_apl* ]]; then
    TARGET_ENDPOINT="/v1/datasets/_apl${TARGET_ENDPOINT#/v1/query/_apl}"
  fi
elif [[ "$ENDPOINT" != /v1/ingest/* && "$TARGET_BASE_URL" =~ ^https://([a-z0-9-]+\.)+edge\.axiom\.co$ ]]; then
  TARGET_BASE_URL="https://api.axiom.co"
fi

if [[ -n "$BODY" ]]; then
  "$SCRIPT_DIR/curl-auth" axiom "$DEPLOYMENT" -X "$METHOD" -d "$BODY" "${TARGET_BASE_URL}${TARGET_ENDPOINT}"
else
  "$SCRIPT_DIR/curl-auth" axiom "$DEPLOYMENT" -X "$METHOD" "${TARGET_BASE_URL}${TARGET_ENDPOINT}"
fi
