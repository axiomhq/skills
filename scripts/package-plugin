#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: bash scripts/package-plugin /path/to/axiom-plugin.zip" >&2
  exit 1
fi

cd "$(dirname "$0")/.."
version=$(git show HEAD:version.txt)
for manifest in .codex-plugin/plugin.json .claude-plugin/plugin.json \
  .cursor-plugin/plugin.json .grok-plugin/plugin.json gemini-extension.json; do
  if ! git show "HEAD:$manifest" | jq -e --arg version "$version" '.version == $version' >/dev/null; then
    echo "$manifest must match version.txt ($version)" >&2
    exit 1
  fi
done

paths=(.codex-plugin .claude-plugin .cursor-plugin .grok-plugin .mcp.json
  gemini-extension.json skills README.md LICENSE version.txt)
for optional in assets docs CHANGELOG.md; do
  if git cat-file -e "HEAD:$optional" 2>/dev/null; then
    paths+=("$optional")
  fi
done

git archive --format=zip --output="$1" HEAD "${paths[@]}"
